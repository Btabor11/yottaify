{
  "name": "yottaify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit.mjs",
    "verify:identity": "node scripts/verify-identity.mjs",
    "verify:schema": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/validate-check.mjs",
    "verify:contrast": "node scripts/contrast.mjs",
    "market:probe": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/market/probe.mjs",
    "market:refresh": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/market/refresh.mjs",
    "shot": "node scripts/shot.mjs",
    "check:drift": "node scripts/drift.mjs",
    "check:scroll": "node scripts/scroll.mjs",
    "check:sweep": "node scripts/sweep.mjs",
    "check:shader": "node scripts/shader-probe.mjs",
    "perf": "node scripts/perf.mjs",
    "perf:bundle": "node scripts/bundle.mjs",
    "perf:chunks": "node scripts/chunks.mjs",
    "perf:critical": "node scripts/critical.mjs",
    "perf:tasks": "node scripts/tasks.mjs",
    "perf:profile": "node scripts/profile.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run typecheck && npm run lint && npm run audit && npm run verify:identity && npm run verify:schema"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.26.0",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
