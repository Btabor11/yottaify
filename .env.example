# ---------------------------------------------------------------------------
# Copy to .env.local. Nothing here is required to run the site locally: with
# every value unset, reservations are written to .data/ as JSON, no email is
# sent, and /admin answers 404. See DATA.md for what each service adds.
# ---------------------------------------------------------------------------

# --- where the data lives ---------------------------------------------------
# Postgres connection string (Neon, Supabase, RDS, local). Unset = JSON files
# under .data/ — fine for a laptop, NOT durable on Vercel. Run `npm run db:push`
# once after setting it.
DATABASE_URL=

# Directory for the file store when DATABASE_URL is unset. Default .data
DATA_DIR=

# Random string. Client IPs are stored only as a salted SHA-256 with this salt.
# Change it and every stored hash stops matching — that is the point.
IP_HASH_SALT=

# --- notifications ----------------------------------------------------------
# Resend API key. Unset = no email; the reservation is still stored.
RESEND_API_KEY=
# Verified sender, e.g. "Reservations <reservations@yourdomain.com>".
# Defaults to SITE.email.reservations from config/site.ts.
MAIL_FROM=
# Where the internal "new reservation" email goes. Comma-separate for several.
# Defaults to SITE.email.sales.
NOTIFY_TO=
# Optional JSON POST per reservation (Slack incoming webhook, Zapier, Make, CRM).
RESERVATION_WEBHOOK_URL=

# --- admin desk (/admin) ----------------------------------------------------
# Both must be set or the route answers 404. HTTP Basic auth; use a long
# random password and HTTPS. CSV export: curl -u USER:PASS <site>/admin/export
ADMIN_USER=
ADMIN_PASSWORD=

# --- client-side -------------------------------------------------------------
# Where the form posts. Default /api/reservation (this app). Point at an
# external endpoint only if you are not using the built-in pipeline.
NEXT_PUBLIC_RESERVATION_ENDPOINT=

# Analytics: none | firstparty | plausible | vercel | console
#   firstparty — events go to /api/event and into your own database. No
#                third party, no cookie, works with the file store too.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Absolute site origin, used for canonical URLs, sitemap and OG image resolution.
NEXT_PUBLIC_SITE_URL=

# --- market tracker (/market) ------------------------------------------------
# Random string, 32+ bytes. Vercel Cron sends it as a Bearer token to
# /api/market/refresh once a day (vercel.json). Unset = the route answers 503
# and nothing refreshes. Locally, `npm run market:refresh` needs no secret.
CRON_SECRET=
