# Reservation submissions POST here when set. Unset = local dev stub (logs + resolves success).
# Swap in a real endpoint (Formspark, Basin, /api/reservation, CRM webhook) without touching component code.
NEXT_PUBLIC_RESERVATION_ENDPOINT=

# Analytics provider. Unset or "none" = no-op. Supported: none | plausible | vercel | console
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Absolute site origin, used for canonical URLs and OG image resolution.
NEXT_PUBLIC_SITE_URL=
